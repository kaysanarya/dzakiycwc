# VELLUM AI — Environment Template
# Copy file ini ke .env.local dan isi API key kamu
# JANGAN commit .env.local ke git!

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
AI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model vision (untuk analyzeProduct, analyzeReference, validateConsistency)
# Hasil probe 2026-10-04: gemini-3.5-flash = OK | gemini-3.8-flash = 429 free tier
AI_VISION_MODEL=gemini-3.5-flash

# Model validation (sama dengan vision, bisa beda jika perlu)
AI_VALIDATION_MODEL=gemini-3.5-flash

# Model image generation (harus support generateContent + responseModalities IMAGE)
# Kandidat: gemini-3.1-flash-image, gemini-2.5-flash-image
# Kosongkan jika quota habis -- pipeline otomatis ke Pollinations Flux
AI_IMAGE_MODEL=

# Nyalakan/matikan vision judge (on/off). Matikan jika kuota vision terbatas.
AI_JUDGE=off

# Maks API calls per satu request /api/generate
AI_MAX_CALLS_PER_REQUEST=8

# Set true untuk disable mode demo (gunakan API key asli, bukan demo data)
DISABLE_DEMO_MODE=true

# ── OpenAI (opsional, untuk DALL-E 3) ────────────────────────────────────────
OPENAI_API_KEY=

# ── Stability AI (opsional, untuk inpainting) ─────────────────────────────────
STABILITY_API_KEY=

# ── Replicate (opsional) ──────────────────────────────────────────────────────
REPLICATE_API_TOKEN=

# ── Supabase (opsional, untuk storage) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
